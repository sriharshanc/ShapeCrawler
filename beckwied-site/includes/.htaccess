# Block direct web access to includes/ (config, DB helpers, form partials).
# These files are only ever loaded via PHP require/include, never requested
# directly by a browser.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
